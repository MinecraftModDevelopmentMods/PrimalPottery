{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "on_shelf",
        "model": {
          "type": "minecraft:special",
          "base": "primalpottery:item/raw_pottery",
          "model": {
            "type": "primalpottery:pottery",
            "on_shelf": true
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "primalpottery:item/raw_pottery",
      "model": {
        "type": "primalpottery:pottery"
      }
    }
  }
}
